Cell[CellGroupData[{

Cell["Funciones generales", "Section",
 CellChangeTimes->{{3.9851905395759425`*^9, 
  3.985190545244315*^9}},ExpressionUUID->"c331393d-75c2-4616-9f80-\
2e9cc2abc41f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"epsRe", "[", 
    RowBox[{"parteRe_", ",", "parteIm_", ",", "x_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"parteRe", "[", "x", "]"}], "^", "2"}], "-", 
    RowBox[{
     RowBox[{"parteIm", "[", "x", "]"}], "^", "2"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"epsIm", "[", 
    RowBox[{"parteRe_", ",", "parteIm_", ",", "x_"}], "]"}], ":=", 
   RowBox[{"(", 
    RowBox[{"2", "*", 
     RowBox[{"parteRe", "[", "x", "]"}], "*", 
     RowBox[{"parteIm", "[", "x", "]"}]}], ")"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"eps", "[", 
     RowBox[{"parteRe_", ",", "parteIm_", ",", "x_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"parteRe", "[", "x", "]"}], "+", 
       RowBox[{"I", " ", 
        RowBox[{"parteIm", "[", "x", "]"}]}]}], ")"}], "^", "2"}]}], ";"}], 
  "\n", "\n", "\n", 
  RowBox[{"(*", 
   RowBox[{
   "Funci\[OAcute]n", " ", "para", " ", "que", " ", "haga", " ", "todo", " ", 
    "autom\[AAcute]tico"}], "*)"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"lorentzFitSSKK", "[", 
    RowBox[{
    "parteRe_", ",", "parteIm_", ",", "intervalos_", ",", "xmin_", ",", 
     "xmax_", ",", "tol_", ",", "omegalist_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "total", ",", "epsIm", ",", "epsRe", ",", "sinPico", ",", "partere2"}], 
      "}"}], ",", "\n", "                                  ", 
     RowBox[{
      RowBox[{
       RowBox[{"epsIm", "[", "x_", "]"}], ":=", 
       RowBox[{"Im", "[", 
        RowBox[{"eps", "[", 
         RowBox[{"parteRe", ",", "parteIm", ",", "x"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "                                  ", 
      RowBox[{
       RowBox[{"epsRe", "[", "x_", "]"}], ":=", 
       RowBox[{"Re", "[", 
        RowBox[{"eps", "[", 
         RowBox[{"parteRe", ",", "parteIm", ",", "x"}], "]"}], "]"}]}], ";", 
      "\n", "                                  ", 
      RowBox[{"sinPico", "=", 
       RowBox[{"ajusteSinPico", "[", 
        RowBox[{
        "epsIm", ",", "intervalos", ",", "tol", ",", "xmin", ",", "xmax"}], 
        "]"}]}], ";", "\n", "                                  ", 
      RowBox[{"partere2", "=", 
       RowBox[{"parteReSSKK", "[", 
        RowBox[{"epsRe", ",", 
         RowBox[{"sinPico", "[", 
          RowBox[{"[", "2", "]"}], "]"}], ",", "xmin", ",", "xmax", ",", 
         "omegalist"}], "]"}]}], ";", 
      RowBox[{"{", 
       RowBox[{"sinPico", ",", "partere2"}], "}"}]}]}], "]"}]}], 
  ";"}]}], "Code",
 CellChangeTimes->{{3.992343192927871*^9, 3.992343193891904*^9}},
 CellLabel->"In[13]:=",ExpressionUUID->"217df0b7-fcb4-489b-8f1e-f7f50a5550be"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Datos beta y H2O -> Parte real", "Section",
 CellChangeTimes->{{3.9851911506942525`*^9, 3.985191162216729*^9}, {
  3.98519393150478*^9, 
  3.9851939485551357`*^9}},ExpressionUUID->"0bff39f5-e2e5-48d8-acb9-\
de92e6178e1b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Funci\[OAcute]n", " ", "que", " ", "da", " ", "la", " ", "parte", " ", 
    "real", " ", "del", " ", "\[IAcute]ndice", " ", "de", " ", 
    "refracci\[OAcute]n", " ", "a", " ", "partir", " ", "de", " ", "la", " ", 
    "relaci\[OAcute]n", " ", "de", " ", "Meinke", " ", "2006"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"datosH2O", "=", 
     RowBox[{
     "Import", "[", 
      "\"\<C:\\\\Users\\\\danal\\\\Documents\\\\Grupo_Nanoplasm\[OAcute]nica\\\
\\Tesis\\\\Refractive index\\\\H2O_n.csv\>\"", "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"datosBeta", "=", 
     RowBox[{
     "Import", "[", 
      "\"\<C:\\\\Users\\\\danal\\\\Documents\\\\Grupo_Nanoplasm\[OAcute]nica\\\
\\Tesis\\\\Refractive index\\\\Beta_parameter_ReN_Erythrocytes.csv\>\"", 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"datos1Beta", "=", 
     RowBox[{"Drop", "[", 
      RowBox[{"datosBeta", ",", "1"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"datos1H2O", "=", 
     RowBox[{"Drop", "[", 
      RowBox[{"datosH2O", ",", "1"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"datos2Beta", "=", 
     RowBox[{"h", " ", 
      RowBox[{"c", "/", 
       RowBox[{"datos1Beta", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "1"}], "]"}], "]"}]}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"datos2H2O", "=", 
     RowBox[{"h", " ", 
      RowBox[{"c", "/", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"datos1H2O", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "1"}], "]"}], "]"}], "*", "1000"}], 
        ")"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"beta", "=", 
    RowBox[{"Interpolation", "[", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"datos2Beta", ",", 
        RowBox[{"datos1Beta", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "2"}], "]"}], "]"}]}], "}"}], "]"}], "]"}]}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"h2o", "=", 
     RowBox[{"Interpolation", "[", 
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{"datos2H2O", ",", 
         RowBox[{"datos1H2O", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "2"}], "]"}], "]"}]}], "}"}], "]"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Se", " ", "va", " ", "a", " ", "encontrar", " ", "la", " ", "parte", " ",
      "real", " ", "empleando", " ", "la", " ", "relaci\[OAcute]n", " ", "de",
      " ", "Meinke", " ", "2006"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"parteRe", "[", 
      RowBox[{"x_", ",", "C_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"h2o", "[", "x", "]"}], "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"beta", "[", "x", "]"}], "*", "C"}], ")"}], "+", "1"}], 
       ")"}]}]}], ";"}]}]}]], "Code",
 CellChangeTimes->{3.985193967635079*^9},
 CellLabel->"In[17]:=",ExpressionUUID->"a032300e-d65b-4d8b-83bb-1e0397eefaca"],

