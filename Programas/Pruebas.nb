 RowBox[{
  RowBox[{
   RowBox[{"datos3im30", "=", 
    RowBox[{
     RowBox[{"datos1uA30", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "2"}], "]"}], "]"}], "*", 
     RowBox[{"10", "^", 
      RowBox[{"(", 
       RowBox[{"-", "6"}], ")"}]}], "*", 
     RowBox[{
      RowBox[{"datos1uA30", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "1"}], "]"}], "]"}], "/", 
      RowBox[{"(", 
       RowBox[{"4", "*", "Pi"}], ")"}]}]}]}], ";"}], "\n", 
  RowBox[{"(*", 
   RowBox[{
   "Se", " ", "interpolan", " ", "los", " ", "datos", " ", "de", " ", "la", 
    " ", "parte", " ", "imaginaria"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"parteIm300", "=", 
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"datos1uA30", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "1"}], "]"}], "]"}], ",", "datos3im30"}], "}"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"parteIm30", "=", 
